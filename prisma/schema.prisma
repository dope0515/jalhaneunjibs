// 1. 설정: 어떤 도구를 쓸 건지 정합니다.
generator client {
  provider = "prisma-client-js"
}

// 2. 연결: 우리 DB 주소를 가져옵니다 (.env 파일에 적어둔 주소를 사용함)
datasource db {
  provider = "postgresql"
}

// 3. 설계도: 실제 '사용자(User)' 테이블의 모습입니다.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  password     String
  nickname     String?
  emailVerified Boolean  @default(false)
  
  // 👈 이 줄을 추가해서 사용자가 쓴 리뷰들을 연결합니다.
  reviews      Review[] 
  favorites    Favorite[]   // 사용자가 즐겨찾기한 내역들
  collections  Collection[] // 사용자가 만든 찜 폴더들 (에어비앤비 위시리스트 스타일)
  
  // 팔로우 시스템
  followers    Follow[]     @relation("following")
  following    Follow[]     @relation("follower")

  refreshTokens RefreshToken[]

  createdAt    DateTime @default(now())
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 4. 설계도: 실제 '맛집(Restaurant)' 테이블
enum RestaurantStatus {
  ACTIVE    // 영업 중
  CLOSED    // 폐업
  HIDDEN    // 숨김 (관리자용)
}

model Restaurant {
  id               Int      @id @default(autoincrement())
  
  // 외부 API 연동 시 필수 (카카오맵 등에서 가져온 고유 ID)
  placeId          String?  @unique 
  
  name             String   
  description      String?  // 식당 한줄 소개 또는 상세 설명
  thumbnail        String?  
  foodCategory     String? 
  status           RestaurantStatus @default(ACTIVE)
  
  // 전체 주소와 분리된 행정구역 (지역 필터링 성능 최적화)
  address          String   // 전체 지번/도로명 주소
  region1          String?  // 시/도 (예: 서울특별시)
  region2          String?  // 구/군 (예: 강남구)
  region3          String?  // 동/면/읍 (예: 역삼동)
  
  // 위치 정보
  lat              Float?   // 위도
  lng              Float?   // 경도
  
  // 비즈니스 정보 (선택)
  phoneNumber      String?  
  openingHours     String?  // "11:00 - 22:00" 같은 문자열 형식
  
  // 키워드
  keywords         String[] // ["가성비", "데이트", "주차가능"]
  
  // 통계 데이터 (정렬 및 조회 성능 최적화용)
  likes            Int      @default(0) // 찜하기 수
  viewCount        Int      @default(0) // 조회수 (인기순 정렬용)
  reviewCount      Int      @default(0) // 리뷰 총 개수 ⭐️
  averageRating    Float    @default(0) // 평균 평점 ⭐️
  
  // 관계 설정
  reviews          Review[] // 리뷰들과 연결
  menus            Menu[]   // 메뉴들과 연결
  favorites        Favorite[] // 이 식당을 즐겨찾기한 유저들

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt  // 식당 정보가 수정된 시간 기록용 (필수 권장)

  // 검색 최적화를 위한 인덱스
  @@index([region2])      // '구' 단위 검색용
  @@index([region3])      // '동' 단위 검색용
  @@index([foodCategory]) // 카테고리 검색용
  @@index([lat, lng])     // 위치 기반 검색용
}


// 5. 설계도: 리뷰(Review) 테이블
model Review {
  id           Int      @id @default(autoincrement())
  rating       Int      // 이 사용자가 준 별점
  content      String?  // 리뷰 내용
  images       String[] // 리뷰에 올린 사진들
  
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  
  userId       Int
  user         User       @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
}

// 6. 설계도: 메뉴(Menu) 테이블 (AI 분석 결과 저장용)
model Menu {
  id            Int      @id @default(autoincrement())
  name          String   // 메뉴 이름 (예: 김치찌개)
  price         Int?     // 가격 (숫자 타입으로 변경하여 정렬/필터링 최적화)
  description   String?  // 메뉴 설명
  image         String?  // 메뉴 사진
  isRecommended Boolean  @default(false) // 추천 메뉴 여부
  
  restaurantId  Int
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
}

// 7. 설계도: 즐겨찾기(Favorite) 테이블
model Favorite {
  id           Int        @id @default(autoincrement())
  
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  
  collectionId Int?       // 어떤 폴더(Collection)에 저장했는지 (선택 사항)
  collection   Collection? @relation(fields: [collectionId], references: [id])
  
  createdAt    DateTime   @default(now())

  // 특정 폴더 내에서 식당 중복 저장 방지
  @@unique([collectionId, restaurantId])
}

// 8. 설계도: 팔로우(Follow) 테이블
model Follow {
  followerId  Int
  follower    User @relation("follower", fields: [followerId], references: [id])
  
  followingId Int
  following   User @relation("following", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

// 9. 설계도: 찜 폴더(Collection) 테이블 (에어비앤비 위시리스트 스타일)
model Collection {
  id          Int      @id @default(autoincrement())
  name        String   // 폴더 이름 (예: "데이트 코스", "부모님과 함께")
  isPrivate   Boolean  @default(true) // 나만 보기 설정 (기본값 true)
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  favorites   Favorite[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
