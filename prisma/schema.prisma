// 1. 설정: 어떤 도구를 쓸 건지 정합니다.
generator client {
  provider = "prisma-client-js"
}

// 2. 연결: 우리 DB 주소를 가져옵니다 (.env 파일에 적어둔 주소를 사용함)
datasource db {
  provider = "postgresql"
}

// 3. 설계도: 실제 '사용자(User)' 테이블의 모습입니다.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  nickname     String?
  profileImage String?
  phoneNumber  String?
  
  // 👈 이 줄을 추가해서 사용자가 쓴 리뷰들을 연결합니다.
  reviews      Review[] 
  createdAt    DateTime @default(now())
}

// 4. 설계도: 실제 '맛집(Restaurant)' 테이블
model Restaurant {
  id           Int      @id @default(autoincrement())
  name         String   
  thumbnail    String?  
  foodCategory String? 
  address      String   
  
  // 위치 정보 추가
  lat          Float?   // 위도
  lng          Float?   // 경도
  
  // 키워드 추가
  keywords     String[] // ["가성비", "데이트", "주차가능"]
  
  likes        Int      @default(0)
  
  // 관계 설정
  reviews      Review[] // 리뷰들과 연결
  menus        Menu[]   // 메뉴들과 연결

  createdAt    DateTime @default(now())
}

// 5. 설계도: 리뷰(Review) 테이블
model Review {
  id           Int      @id @default(autoincrement())
  rating       Int      // 이 사용자가 준 별점
  content      String?  // 리뷰 내용
  images       String[] // 리뷰에 올린 사진들
  
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  
  userId       Int
  user         User       @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
}

// 6. 설계도: 메뉴(Menu) 테이블 (AI 분석 결과 저장용)
model Menu {
  id           Int      @id @default(autoincrement())
  name         String   // 메뉴 이름 (예: 김치찌개)
  price        String?  // 가격 (예: 9,000원)
  image        String?  // 메뉴 사진
  
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}
